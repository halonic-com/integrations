            ],
            "webViewLink": "https://drive.google.com/file/d/file-notes-02/view"
          }
        },
        "headers": {
          "content-type": "application/json; charset=UTF-8"
        },
        "status": 200
      },
      "transport": "http"
    }
  ],
  "format": "halonic.recording/1",
  "integration": "tool-google-drive",
  "scenario": "update-file",
  "scrubReport": [
    {
      "count": 1,
